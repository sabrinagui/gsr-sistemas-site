# Copy to /opt/gsr-site/.env and chmod 600; fill only on the server.
GSR_IMAGE=ghcr.io/sabrinagui/gsr-sistemas-site:REPLACE_WITH_COMMIT_SHA
GSR_APP_PORT=13020
POSTGRES_PASSWORD=
# URL-encode the password in this URI. Do not commit the actual file.
DATABASE_URI=postgresql://gsr:REPLACE_WITH_URLENCODED_PASSWORD@gsr-db:5432/gsr
PAYLOAD_SECRET=
PREVIEW_SECRET=
NEXT_PUBLIC_SITE_URL=https://gsrsistemas.com
SITE_ENV=preview
# Enable only after restore, schema comparison, and migration baseline.
GSR_MIGRATIONS_READY=0
RESEND_API_KEY=
RESEND_FROM_ADDRESS=nao-responda@mail.gsrsistemas.com
LEAD_NOTIFICATION_EMAIL=contato@gsrsistemas.com
