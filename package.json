{
  "name": "gsr-sistemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed:redirects": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local scripts/seed-redirects.ts",
    "check:redirects": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-redirects.ts",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local scripts/seed-content.ts",
    "seed:examples": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local scripts/seed-example-cases.ts",
    "seed:real": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env.local scripts/seed-real-content.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.11.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.186.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
