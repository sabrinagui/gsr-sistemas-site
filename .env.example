# ─── Aplicação ────────────────────────────────────────────────────────────────
# Forma canônica: sem www, sem barra final. Fonte única de URL absoluta.
NEXT_PUBLIC_SITE_URL=https://gsrsistemas.com
SITE_ENV=development

# Chave de assinatura do Payload. Gere uma nova: openssl rand -base64 32
PAYLOAD_SECRET=

# ─── Banco (Neon) ─────────────────────────────────────────────────────────────
# Use a string de POOLING (com -pooler no host). Sem ela, cada requisição
# serverless abre uma conexão nova — aparece como lentidão intermitente.
# Branch separado para preview: nunca aponte preview para a base de produção.
DATABASE_URI=postgresql://user:senha@ep-xxx-pooler.region.aws.neon.tech/gsr?sslmode=require

# ─── Mídia (Cloudflare R2) ────────────────────────────────────────────────────
# Sem estas variáveis o projeto roda com disco local, o que serve para
# desenvolvimento. Em produção são obrigatórias: o disco da Vercel é efêmero.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domínio público do bucket. Entra em next.config.ts como remotePattern.
NEXT_PUBLIC_MEDIA_URL=

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# Domínio de envio precisa de SPF e DKIM verificados. Recomendado: subdomínio
# dedicado ao transacional, separado de contato@gsrsistemas.com.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=nao-responda@mail.gsrsistemas.com
LEAD_NOTIFICATION_EMAIL=contato@gsrsistemas.com

# ─── Preview ──────────────────────────────────────────────────────────────────
PREVIEW_SECRET=
