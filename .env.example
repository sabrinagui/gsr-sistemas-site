# ─── Aplicação ────────────────────────────────────────────────────────────────
# Forma canônica: sem www, sem barra final. Fonte única de URL absoluta.
NEXT_PUBLIC_SITE_URL=https://gsrsistemas.com
SITE_ENV=development

# Chave de assinatura do Payload. Gere uma nova: openssl rand -base64 32
PAYLOAD_SECRET=

# ─── Banco local (PostgreSQL 18) ──────────────────────────────────────────────
# Não usar o banco original para testar migrations. Produção: deploy/server.env.example.
DATABASE_URI=postgresql://postgres:CHANGE_ME@localhost:5432/gsr

# ─── Mídia (Cloudflare R2) ────────────────────────────────────────────────────
# Opcional. Sem estas variáveis o Payload usa media na raiz do projeto.
# No servidor Docker essa pasta é preservada pelo volume exclusivo gsr-media.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domínio público do bucket. Entra em next.config.ts como remotePattern.
NEXT_PUBLIC_MEDIA_URL=

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# Domínio de envio precisa de SPF e DKIM verificados. Recomendado: subdomínio
# dedicado ao transacional, separado de contato@gsrsistemas.com.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=nao-responda@mail.gsrsistemas.com
LEAD_NOTIFICATION_EMAIL=contato@gsrsistemas.com

# ─── Preview ──────────────────────────────────────────────────────────────────
PREVIEW_SECRET=

# ─── Jobs (publicação agendada) ───────────────────────────────────────────────
# Só necessário em hospedagem serverless, onde um cron externo chama
# /api/payload-jobs/run. Em Docker o próprio processo executa a fila.
CRON_SECRET=
